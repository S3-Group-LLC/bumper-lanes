# Names of the settings this app needs. NO real values here — this file is public.
#
# Where the real values go:
#   • Vercel → your project → Settings → Environment Variables (for the live site and previews)
#   • Connecting Supabase to Vercel fills these in for you automatically.
#
# Your Supabase project's web address, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Your Supabase "publishable" key (safe to use in the browser; starts with sb_publishable_).
# Older Supabase projects call this the "anon" key — NEXT_PUBLIC_SUPABASE_ANON_KEY also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
